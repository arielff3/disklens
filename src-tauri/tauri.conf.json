{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disklens",
  "version": "0.2.0",
  "identifier": "dev.disklens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disklens",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ariel",
    "copyright": "Copyright (c) 2026 Ariel. MIT License.",
    "homepage": "https://github.com/arielff3/disklens",
    "shortDescription": "See where your disk space went",
    "longDescription": "Disklens scans your drives, explains what Windows and your apps keep on disk, and cleans up safely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
